# Copy these names into your local environment or secret manager.
# Never commit a real API key.
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=replace-with-a-secret
AZURE_OPENAI_API_VERSION=replace-with-your-supported-api-version

# Optional: Terra is used by default. Set this only to test another deployment.
# AZURE_OPENAI_DEPLOYMENT=gpt-5.6-terra

# Optional production controls
AZURE_OPENAI_TIMEOUT_SECONDS=30
AZURE_OPENAI_MAX_RETRIES=2
AZURE_OPENAI_MAX_OUTPUT_TOKENS=1200

# Leave unset when a deployment does not support temperature.
# AZURE_OPENAI_TEMPERATURE=0
